#!/usr/bin/env bash
# Shortcuts for the PAPER-trading bot on the Oracle server.  Usage: tb <command>
#   tb check            test keys + connections (Alpaca paper, Gemini, TradingAgents, GitHub). Places no orders.
#   tb start | stop | restart | status
#   tb logs             follow the bot live (Ctrl+C stops watching, not the bot)
#   tb report           build the 7-day report now and save it to the Trading tab
#   tb backtest 365     backtest the last N days in the background (safe to log out); continues where it stopped
#   tb backtest-log     follow the backtest
#   tb replay           what the strict / loose / any entry rules would have traded this week (no orders)
#   tb rules loose      switch entry rules: strict (2 sources, volume 1.5x) | loose (1 reputable, 1.2x) | any | aggressive
#   tb size 50          invest up to 50% of the account (rest stays cash). Bot sizes each trade itself (auto). No limit on trades
#   tb size 50 10       same, but fix every trade at 10% (tb size 50 auto = back to automatic sizing)
#   tb tradestie       type your free Tradestie key (hidden) for r/wallstreetbets buzz (optional: works without)
#   tb core 50          keep 50% of the invested budget in the halal market ETFs SPUS + HLAL (rides green days). 0 = off
#   tb trail 3          trailing stop: sell only after a 3% drop from the high (lets winners run). tb trail 0 = fixed -3%/+6%
#   tb study            build today's Market Study now (trend + momentum + quality ranking of every halal name)
#   tb study-backtest 12  test the trend rules on the last 12 months of daily prices (no orders, ~1 min)
#   tb trend 30         put 30% of the invested budget in the Market Study picks (trend sleeve). tb trend 0 = off
#   tb lab keys         type extra Gemini keys for the Research Lab (hidden; one per Google project)
#   tb lab start 7      start the Research Lab for 7 days (studies traders, tests their rules; never trades)
#   tb lab status | stop | report | logs
#   tb coach            run the Coach's review now (what it learned + its own settings); tb coach reset = undo all
#   tb universe         re-run the halal screen now and show how many stocks + coins pass
#   tb unlock           turn the kill switch off again (only after you've reviewed why it fired)
#   tb update           pull the newest code from GitHub and restart the bot
set -euo pipefail
REPO=~/agent-hq-trading
PY="$REPO/trading_bot/.venv/bin/python"
cd "$REPO"
case "${1:-help}" in
  check)        "$PY" -m trading_bot.bot check ;;
  start)        sudo systemctl start agenthq-trading && sleep 3 && systemctl --no-pager status agenthq-trading | head -5 ;;
  stop)         sudo systemctl stop agenthq-trading && echo "Stopped (stop-losses stay live on Alpaca's side)." ;;
  restart)      sudo systemctl restart agenthq-trading && echo "Restarted." ;;
  status)       systemctl --no-pager status agenthq-trading | head -12; echo; systemctl --no-pager list-timers agenthq-trading-report.timer | head -3 ;;
  logs)         journalctl -u agenthq-trading -f -n 50 ;;
  report)       "$PY" -m trading_bot.weekly | head -40 ;;
  backtest)     D="${2:-365}"; shift 2 2>/dev/null || shift
                nohup nice -n 10 "$PY" -m trading_bot.backtest "$D" "$@" >> ~/logs/backtest.log 2>&1 &
                echo "Backtest of the last $D days started in the background (pid $!). Watch it: tb backtest-log" ;;
  backtest-log) tail -n 40 -f ~/logs/backtest.log ;;
  replay)       "$PY" -m trading_bot.replay "${2:-}" ;;
  rules)        M="${2:-}"; case "$M" in strict|loose|any|aggressive|ultra) ;; *) echo "Use: tb rules strict|loose|any|aggressive|ultra"; grep -h '^TRADING_RULES' ~/.trading-bot.env 2>/dev/null || echo "(now: strict)"; exit 1;; esac
                touch ~/.trading-bot.env; chmod 600 ~/.trading-bot.env
                sed -i '/^TRADING_RULES=/d' ~/.trading-bot.env && echo "TRADING_RULES=$M" >> ~/.trading-bot.env
                sudo systemctl restart agenthq-trading && echo "Entry rules now: $M (stop-loss, day halt and kill switch unchanged). Bot restarted." ;;
  size)         M="${2:-}"; P="${3:-}"; case "$M" in ''|*[!0-9]*) echo "Use: tb size <max % invested> [% per trade]   e.g. tb size 50 10"; echo "Now: max $(grep -h '^INVEST_PCT' ~/.trading-bot.env 2>/dev/null | cut -d= -f2 || true)% invested (25 if blank), per trade: $(grep -h '^PER_TRADE_PCT' ~/.trading-bot.env 2>/dev/null | cut -d= -f2 || true) (auto if blank)"; exit 1;; esac
                sed -i '/^INVEST_PCT=/d' ~/.trading-bot.env && echo "INVEST_PCT=$M" >> ~/.trading-bot.env
                if [ -n "$P" ]; then sed -i '/^PER_TRADE_PCT=/d' ~/.trading-bot.env && echo "PER_TRADE_PCT=$P" >> ~/.trading-bot.env; fi
                sudo systemctl restart agenthq-trading && echo "Now: up to $M% invested, per trade: $(grep -h '^PER_TRADE_PCT' ~/.trading-bot.env | cut -d= -f2 || true) (auto if blank), no limit on how many. Stop-loss, day halt, kill switch unchanged. Bot restarted." ;;
  tradestie)    read -rsp "Tradestie API key (hidden): " K && echo && sed -i '/^TRADESTIE_API_KEY=/d' ~/.trading-bot.env && echo "TRADESTIE_API_KEY=$K" >> ~/.trading-bot.env && unset K && sudo systemctl restart agenthq-trading && echo "Tradestie key saved. Bot restarted." ;;
  core)         M="${2:-}"; case "$M" in ''|*[!0-9]*) echo "Use: tb core <0-90>  (now: $(grep -h '^CORE_PCT' ~/.trading-bot.env 2>/dev/null | cut -d= -f2 || true) / 50 if blank)"; exit 1;; esac
                sed -i '/^CORE_PCT=/d' ~/.trading-bot.env && echo "CORE_PCT=$M" >> ~/.trading-bot.env
                sudo systemctl restart agenthq-trading && echo "Core holding now: $M% of the invested budget in SPUS + HLAL. Bot restarted." ;;
  trail)        M="${2:-}"; case "$M" in ''|*[!0-9.]*) echo "Use: tb trail <percent, 0 = off>  (now: $(grep -h '^TRAIL_PCT' ~/.trading-bot.env 2>/dev/null | cut -d= -f2 || true) / 3 if blank)"; exit 1;; esac
                sed -i '/^TRAIL_PCT=/d' ~/.trading-bot.env && echo "TRAIL_PCT=$M" >> ~/.trading-bot.env
                sudo systemctl restart agenthq-trading && echo "Trailing stop now: $M% (new trades). Bot restarted." ;;
  coach)        "$PY" -m trading_bot.coach "${2:-}" ;;
  study)        "$PY" -m trading_bot.study ;;
  lab)          case "${2:-status}" in
                  keys)   K_ALL=""; i=1
                          while true; do read -rsp "Lab Gemini key $i (hidden, just Enter when done): " K; echo
                            [ -z "$K" ] && break; K_ALL="${K_ALL:+$K_ALL,}$K"; i=$((i+1)); done
                          [ -z "$K_ALL" ] && { echo "No keys entered, nothing changed."; exit 0; }
                          OLD=$(grep -h '^LAB_GEMINI_KEYS=' ~/.trading-bot.env 2>/dev/null | cut -d= -f2- || true)
                          sed -i '/^LAB_GEMINI_KEYS=/d' ~/.trading-bot.env && echo "LAB_GEMINI_KEYS=${OLD:+$OLD,}$K_ALL" >> ~/.trading-bot.env
                          chmod 600 ~/.trading-bot.env; unset K K_ALL OLD
                          echo "Saved $((i-1)) key(s) for the lab."; systemctl is-active --quiet agenthq-lab && sudo systemctl restart agenthq-lab || true ;;
                  start)  D="${3:-7}"; case "$D" in *[!0-9]*|'') echo "Use: tb lab start <days>"; exit 1;; esac
                          sed "s#__REPO__#$REPO#g; s#__USER__#$(whoami)#g" trading_bot/server/agenthq-lab.service | sudo tee /etc/systemd/system/agenthq-lab.service >/dev/null
                          sudo systemctl daemon-reload && "$PY" -m trading_bot.lab init "$D" && sudo systemctl restart agenthq-lab
                          sleep 3 && systemctl --no-pager status agenthq-lab | head -4 ;;
                  stop)   sudo systemctl stop agenthq-lab && echo "Lab paused (tb lab start continues where it left off)." ;;
                  report) "$PY" -m trading_bot.lab report ;;
                  logs)   journalctl -u agenthq-lab -f -n 40 ;;
                  reset)  sudo systemctl stop agenthq-lab 2>/dev/null || true; "$PY" -m trading_bot.lab reset ;;
                  *)      "$PY" -m trading_bot.lab status ;;
                esac ;;
  study-backtest) "$PY" -m trading_bot.study backtest "${2:-12}" ;;
  trend)        M="${2:-}"; case "$M" in ''|*[!0-9]*) echo "Use: tb trend <0-90>  (now: $(grep -h '^TREND_PCT' ~/.trading-bot.env 2>/dev/null | cut -d= -f2 || true) / 0 = off if blank)"; exit 1;; esac
                sed -i '/^TREND_PCT=/d' ~/.trading-bot.env && echo "TREND_PCT=$M" >> ~/.trading-bot.env
                sudo systemctl restart agenthq-trading && echo "Trend sleeve now: $M% of the invested budget in the Market Study picks (core first, then trend, then news). Bot restarted." ;;
  universe)     "$PY" -m trading_bot.bot universe ;;
  unlock)       "$PY" -m trading_bot.bot unlock ;;
  update)       git pull -q --rebase --autostash origin main && sudo systemctl restart agenthq-trading && { systemctl is-active --quiet agenthq-lab && sudo systemctl restart agenthq-lab || true; } && echo "Updated + restarted." ;;
  *)            sed -n '2,26p' "$0" ;;
esac
