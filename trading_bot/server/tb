#!/usr/bin/env bash
# Shortcuts for the PAPER-trading bot on the Oracle server.  Usage: tb <command>
#   tb check            test keys + connections (Alpaca paper, Gemini, TradingAgents, GitHub). Places no orders.
#   tb start | stop | restart | status
#   tb logs             follow the bot live (Ctrl+C stops watching, not the bot)
#   tb report           build the 7-day report now and save it to the Trading tab
#   tb backtest 365     backtest the last N days in the background (safe to log out); continues where it stopped
#   tb backtest-log     follow the backtest
#   tb replay           what the strict / loose / any entry rules would have traded this week (no orders)
#   tb rules loose      switch entry rules: strict (2 sources, volume 1.5x) | loose (1 reputable, 1.2x) | any | aggressive
#   tb universe         re-run the halal screen now and show how many stocks + coins pass
#   tb unlock           turn the kill switch off again (only after you've reviewed why it fired)
#   tb update           pull the newest code from GitHub and restart the bot
set -euo pipefail
REPO=~/agent-hq-trading
PY="$REPO/trading_bot/.venv/bin/python"
cd "$REPO"
case "${1:-help}" in
  check)        "$PY" -m trading_bot.bot check ;;
  start)        sudo systemctl start agenthq-trading && sleep 3 && systemctl --no-pager status agenthq-trading | head -5 ;;
  stop)         sudo systemctl stop agenthq-trading && echo "Stopped (stop-losses stay live on Alpaca's side)." ;;
  restart)      sudo systemctl restart agenthq-trading && echo "Restarted." ;;
  status)       systemctl --no-pager status agenthq-trading | head -12; echo; systemctl --no-pager list-timers agenthq-trading-report.timer | head -3 ;;
  logs)         journalctl -u agenthq-trading -f -n 50 ;;
  report)       "$PY" -m trading_bot.weekly | head -40 ;;
  backtest)     D="${2:-365}"; shift 2 2>/dev/null || shift
                nohup nice -n 10 "$PY" -m trading_bot.backtest "$D" "$@" >> ~/logs/backtest.log 2>&1 &
                echo "Backtest of the last $D days started in the background (pid $!). Watch it: tb backtest-log" ;;
  backtest-log) tail -n 40 -f ~/logs/backtest.log ;;
  replay)       "$PY" -m trading_bot.replay "${2:-}" ;;
  rules)        M="${2:-}"; case "$M" in strict|loose|any|aggressive) ;; *) echo "Use: tb rules strict|loose|any|aggressive"; grep -h '^TRADING_RULES' ~/.trading-bot.env 2>/dev/null || echo "(now: strict)"; exit 1;; esac
                touch ~/.trading-bot.env; chmod 600 ~/.trading-bot.env
                sed -i '/^TRADING_RULES=/d' ~/.trading-bot.env && echo "TRADING_RULES=$M" >> ~/.trading-bot.env
                sudo systemctl restart agenthq-trading && echo "Entry rules now: $M (stop-loss, day halt and kill switch unchanged). Bot restarted." ;;
  universe)     "$PY" -m trading_bot.bot universe ;;
  unlock)       "$PY" -m trading_bot.bot unlock ;;
  update)       git pull -q --rebase --autostash origin main && sudo systemctl restart agenthq-trading && echo "Updated + restarted." ;;
  *)            sed -n '2,15p' "$0" ;;
esac
