# Agent HQ paper-trading bot settings. Copy to ".env" in this same folder (setup.bat does it)
# and fill in the values. This file stays on your computer: it is git-ignored and never uploaded.

# Alpaca PAPER keys (alpaca.markets -> Paper Trading -> API Keys). Paper only: the bot refuses the live URL.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Same Gemini key you put in GitHub secrets (aistudio.google.com -> API keys)
GEMINI_API_KEY=

# Optional: pin a model instead of auto-picking the newest free Flash
# GEMINI_MODEL=
# TA_QUICK_MODEL=
# TA_DEEP_MODEL=
